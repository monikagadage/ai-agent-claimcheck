{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "ai-agent-claimcheck",
  "displayName": "ai-agent-claimcheck",
  "version": "0.1.0",
  "description": "Verify an AI coding agent's end-of-turn claims against what it actually did. Flags \"tests pass\" when no test ran, \"I edited X\" when nothing touched X, and invented agreements. Deterministic, no network, no model. Warn-only by default.",
  "author": {
    "name": "Monika Gadage",
    "url": "https://github.com/monikagadage"
  },
  "homepage": "https://github.com/monikagadage/ai-agent-claimcheck",
  "repository": "https://github.com/monikagadage/ai-agent-claimcheck",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "verification",
    "hallucination",
    "claims",
    "stop-hook",
    "quality",
    "trust",
    "claimcheck",
    "guardrail"
  ],
  "hooks": "./hooks/hooks.json"
}
